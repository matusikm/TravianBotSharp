<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="using:Material.Icons.Avalonia">
    <!-- Ports of WPFUI/Styles/BorderStyle.xaml; use Classes="Box" etc. -->
    <Style Selector="Border.Box">
        <Setter Property="Margin" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="Border.OverlayBackground">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="DarkGray" />
        <Setter Property="Opacity" Value=".7" />
    </Style>
    <Style Selector="Border.OverlayContent">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="AliceBlue" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10,0,10,0" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #80000000" />
    </Style>
    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="mi|MaterialIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>
    <!-- Keep the height constant so the layout doesn't jump when the floating label moves up. -->
    <Style Selector="TextBox[UseFloatingPlaceholder=True]">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Label">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</Styles>
