<Window
    x:Class="AvaloniaUI.Views.MessageDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    MinHeight="140"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel
            DockPanel.Dock="Bottom"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button x:Name="YesButton" MinWidth="80" Content="Yes" IsDefault="True" />
            <Button x:Name="NoButton" MinWidth="80" Content="No" IsCancel="True" />
            <Button x:Name="OkButton" MinWidth="80" Content="OK" IsDefault="True" IsCancel="True" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </DockPanel>
</Window>
