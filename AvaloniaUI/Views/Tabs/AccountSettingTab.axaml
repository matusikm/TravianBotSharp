<v:AccountSettingTabBase
    x:Class="AvaloniaUI.Views.Tabs.AccountSettingTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:uc="using:AvaloniaUI.Views.UserControls"
    xmlns:v="using:AvaloniaUI.Views.Tabs">
    <Grid Background="#FFE5E5E5" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Margin="10" ColumnDefinitions="4*,*,*">
            <Button x:Name="SaveButton" Grid.Column="0" ToolTip.Tip="Save">
                <mi:MaterialIcon Kind="ContentSave" />
            </Button>
            <Button x:Name="ImportButton" Grid.Column="1" Margin="5,0,0,0" ToolTip.Tip="Import">
                <mi:MaterialIcon Kind="Import" />
            </Button>
            <Button x:Name="ExportButton" Grid.Column="2" Margin="5,0,0,0" ToolTip.Tip="Export">
                <mi:MaterialIcon Kind="Export" />
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Classes="Box">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Activity settings" />
                        <uc:RangeInputUc x:Name="WorkTime" Text="Work time" Unit="hours" />
                        <CheckBox x:Name="LogoutWhenWorkEnds" Content="When work time ends, log out and stop (otherwise sleep and continue)" />
                        <uc:RangeInputUc x:Name="SleepTime" Text="Sleep time" Unit="minutes" />
                    </StackPanel>
                </Border>
                <Border Classes="Box">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Night sleep" />
                        <CheckBox x:Name="EnableNightSleep" Content="Sleep every night, in the account's time zone" />
                        <Grid ColumnDefinitions="*,10,*">
                            <TextBox x:Name="NightSleepStart" Grid.Column="0" PlaceholderText="From (HH:mm)" UseFloatingPlaceholder="True" Margin="0,2" />
                            <TextBox x:Name="NightSleepEnd" Grid.Column="2" PlaceholderText="To (HH:mm)" UseFloatingPlaceholder="True" Margin="0,2" />
                        </Grid>
                        <uc:AmountInputUc x:Name="NightSleepJitter" Text="Random shift each day, up to" Unit="minutes" />
                    </StackPanel>
                </Border>
                <Border Classes="Box">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Delay settings" />
                        <uc:RangeInputUc x:Name="ClickDelay" Text="Click delay" Unit="milliseconds" />
                        <uc:RangeInputUc x:Name="TaskDelay" Text="Task delay" Unit="milliseconds" />
                    </StackPanel>
                </Border>
                <Border Classes="Box">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Feature settings" />
                        <CheckBox x:Name="EnableAutoLoadVillage" Content="Enable auto load village's building" />
                        <CheckBox x:Name="EnableAutoStartAdventure" Content="Enable auto start adventure" />
                        <CheckBox x:Name="EnableAutoClaimDailyQuest" Content="Enable auto claim daily quest" />
                        <CheckBox x:Name="EnableAutoSetHeroPoint" Content="Enable auto set hero point (1 power, 3 res)" />
                    </StackPanel>
                </Border>
                <Border Classes="Box">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Chrome settings" />
                        <CheckBox x:Name="HeadlessChrome" Content="Use headless chrome (easier to detect, not recommended)" />
                        <TextBox x:Name="TimeZoneTextBox" PlaceholderText="Time zone, e.g. Asia/Bangkok (empty: auto from current IP)" UseFloatingPlaceholder="True" Margin="0,2" />
                        <TextBox x:Name="LanguageTextBox" PlaceholderText="Language, e.g. en-US (empty: auto from current IP)" UseFloatingPlaceholder="True" Margin="0,2" />
                    </StackPanel>
                </Border>
                <Border Classes="Box">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Telegram notifications" />
                        <CheckBox x:Name="EnableTelegram" Content="Send Telegram notifications for this account" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2" Opacity="0.75"
                                   Text="Create a bot with @BotFather in Telegram and paste its token here. Open your new bot and press Start, then click Find chat. Send a test message, then Save." />
                        <TextBox x:Name="TelegramBotToken" PasswordChar="•" PlaceholderText="Bot token from @BotFather" UseFloatingPlaceholder="True" Margin="0,2" />
                        <Grid ColumnDefinitions="*,5,Auto,5,Auto">
                            <TextBox x:Name="TelegramChatId" Grid.Column="0" PlaceholderText="Chat ID" UseFloatingPlaceholder="True" Margin="0,2" />
                            <Button x:Name="FindTelegramChatButton" Grid.Column="2" Content="Find chat" VerticalAlignment="Center" />
                            <Button x:Name="SendTelegramTestButton" Grid.Column="4" Content="Send test" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox x:Name="TelegramNotifyAttack" Content="Incoming attack on a village" />
                        <CheckBox x:Name="TelegramNotifyPaused" Content="Bot paused by an error or a long internet outage" />
                        <CheckBox x:Name="TelegramNotifyStorage" Content="Warehouse or granary 90% full" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</v:AccountSettingTabBase>
