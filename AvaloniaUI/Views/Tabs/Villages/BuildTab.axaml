<v:BuildTabBase
    x:Class="AvaloniaUI.Views.Tabs.Villages.BuildTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:v="using:AvaloniaUI.Views.Tabs.Villages">
    <v:BuildTabBase.Styles>
        <!-- Drop marker while a job is dragged: a line above or below the row it will land next to. -->
        <Style Selector="ListBox#JobsGrid ListBoxItem.dropAbove">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="ListBox#JobsGrid ListBoxItem.dropBelow">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
    </v:BuildTabBase.Styles>
    <Grid ColumnDefinitions="*,2,*,2,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Classes="Box" Grid.Row="0">
                <ListBox x:Name="QueueGrid" SelectionMode="Single" ItemTemplate="{StaticResource ListBoxItem}" />
            </Border>
            <Border Classes="Box" Grid.Row="1">
                <ListBox x:Name="BuildingsGrid" SelectionMode="Single" ItemTemplate="{StaticResource ListBoxBlackColorItem}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="UpgradeOneLevelButton" Header="Upgrade one level"><MenuItem.Icon><mi:MaterialIcon Kind="Hammer" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="UpgradeMaxLevelButton" Header="Upgrade max level"><MenuItem.Icon><mi:MaterialIcon Kind="Hammer" /></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>
        </Grid>
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" Classes="Box">
                <Grid RowDefinitions="Auto,Auto,5,Auto" ColumnDefinitions="Auto,*">
                    <Label Grid.Row="0" Grid.Column="0" Content="Building" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <ComboBox x:Name="NormalBuildings" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Label Grid.Row="1" Grid.Column="0" Content="Level" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBox x:Name="NormalLevel" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" />
                    <Button x:Name="NormalBuild" Grid.Row="3" Grid.ColumnSpan="2" ToolTip.Tip="Build">
                        <mi:MaterialIcon Kind="Hammer" Width="30" Height="30" />
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1" Classes="Box">
                <Grid RowDefinitions="Auto,Auto,5,Auto" ColumnDefinitions="Auto,*">
                    <ComboBox x:Name="ResType" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Level" />
                    <TextBox x:Name="ResourceLevel" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" />
                    <Button x:Name="ResourceBuild" Grid.Row="3" Grid.ColumnSpan="2" ToolTip.Tip="Build">
                        <mi:MaterialIcon Kind="Hammer" Width="30" Height="30" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Column="4" RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <Button x:Name="ImportButton" Grid.Column="0" Content="Import" Margin="5" />
                <Button x:Name="ExportButton" Grid.Column="1" Content="Export" Margin="5" />
            </Grid>
            <UniformGrid Grid.Row="1" Rows="1" Margin="2,0">
                <Button x:Name="JobTopButton" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Move selected job to top"><mi:MaterialIcon Kind="ArrowCollapseUp" /></Button>
                <Button x:Name="JobUpButton" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Move selected job up"><mi:MaterialIcon Kind="ArrowUp" /></Button>
                <Button x:Name="JobDownButton" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Move selected job down"><mi:MaterialIcon Kind="ArrowDown" /></Button>
                <Button x:Name="JobBottomButton" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Move selected job to bottom"><mi:MaterialIcon Kind="ArrowCollapseDown" /></Button>
                <Button x:Name="JobDeleteButton" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Delete selected job"><mi:MaterialIcon Kind="Delete" /></Button>
            </UniformGrid>
            <Border Grid.Row="2" Classes="Box">
                <ListBox x:Name="JobsGrid" SelectionMode="Single" ToolTip.Tip="Drag a job to reorder it" ItemTemplate="{StaticResource ListBoxColorItem}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="TopButton" Header="Top"><MenuItem.Icon><mi:MaterialIcon Kind="ArrowUpBold" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="UpButton" Header="Up"><MenuItem.Icon><mi:MaterialIcon Kind="ArrowUp" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="DownButton" Header="Down"><MenuItem.Icon><mi:MaterialIcon Kind="ArrowDown" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="BottomButton" Header="Bottom"><MenuItem.Icon><mi:MaterialIcon Kind="ArrowDownBold" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="DeleteButton" Header="Delete"><MenuItem.Icon><mi:MaterialIcon Kind="Delete" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="DeleteAllButton" Header="Delete all"><MenuItem.Icon><mi:MaterialIcon Kind="DeleteForever" /></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</v:BuildTabBase>
