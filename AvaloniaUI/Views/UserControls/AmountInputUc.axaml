<v:AmountInputUcBase
    x:Class="AvaloniaUI.Views.UserControls.AmountInputUc"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.UserControls"
    x:Name="root">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5,0,0,0">
        <Image Source="/Assets/granary.png" Stretch="None" VerticalAlignment="Center" />
        <TextBox x:Name="Value" PlaceholderText="{Binding #root.Text}" UseFloatingPlaceholder="True" MinWidth="80" Margin="10,0,5,0" />
        <Label Content="{Binding #root.Unit}" VerticalAlignment="Bottom" />
    </StackPanel>
</v:AmountInputUcBase>
